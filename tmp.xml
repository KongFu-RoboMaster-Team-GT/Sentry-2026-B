🧩 四、使用 Xacro 化简版本（推荐实际项目使用）

下面是同样的内容，改成 Xacro 后非常简洁。
要支持 10 个 joint 非常轻松。

▶ 1. 定义一个 joint + link 的 Xacro 宏
<!-- 定义 link 的 Xacro 宏 -->
<xacro:macro name="simple_link" params="name">
  <link name="${name}">
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
  </link>
</xacro:macro>

<!-- 定义 joint 宏 -->
<xacro:macro name="revolute_joint" params="name parent child xyz rpy axis lower upper">
  <joint name="${name}" type="revolute">
    <origin xyz="${xyz}" rpy="${rpy}"/>
    <parent link="${parent}"/>
    <child link="${child}"/>
    <axis xyz="${axis}"/>
    <limit effort="10" velocity="10" lower="${lower}" upper="${upper}"/>
  </joint>

  <transmission name="${name}_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="${name}">
      <hardwareInterface>hardware_interface/Position</hardwareInterface>
    </joint>
    <actuator name="${name}_motor">
      <hardwareInterface>hardware_interface/Position</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>
</xacro:macro>

▶ 2. 在 Xacro 中引用你的关节
