<?xml version="1.0"?>
<robot name="minimal_stl_test" 
       xmlns:xacro="http://ros.org/wiki/xacro">  
       <xacro:property name="pkg_dir" value="package://rm_sim_bringup"/>  
       <xacro:property name="mesh_file" value="models/minimal/box.stl"/> 
       <link name="base_link">
    <visual>
      <geometry>
        <mesh filename="${pkg_dir}/${mesh_file}" scale="1 1 1"/> 
      </geometry>
      <material name="test_material">
        <color rgba="0.8 0.1 0.1 1"/>
      </material>
    </visual>

    <inertial>
      <mass value="1.0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="1.0" ixy="0.0" ixz="0.0" iyy="1.0" iyz="0.0" izz="1.0"/>
    </inertial>
  </link>

  <link name="world"/>

  <joint name="world_fixed_joint" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  
</robot>